{
  "dependencies": {
    "appium": "^3.8.0",
    "webdriverio": "^10.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@wdio/appium-service": "^10.0.1",
    "@wdio/cli": "^10.0.1",
    "@wdio/globals": "^10.0.1",
    "@wdio/local-runner": "^10.0.1",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/reporter": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "appium-uiautomator2-driver": "^8.7.0",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "setup:apps": "tsx scripts/setupApps.ts",
    "test:android": "cross-env PLATFORM=android wdio run config/wdio.conf.ts",
    "test:ios": "cross-env PLATFORM=ios wdio run config/wdio.conf.ts",
    "test:api": "playwright test -c config/playwright.api.config.ts"
  }
}
